# Supabase (사내 api.hr.stek.kr) — 브라우저 클라이언트용 공개 값
# 빌드 시 Vite 가 정적으로 주입. anon key 는 공개 노출 전제(RLS 로 보호).
VITE_SUPABASE_URL="https://api.hr.stek.kr"
VITE_SUPABASE_ANON_KEY="<supabase anon key>"

